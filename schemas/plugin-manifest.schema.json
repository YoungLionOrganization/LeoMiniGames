{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://younglion.xyz/schemas/leominigames/plugin-manifest-rcc-v1.json",
  "title": "LeoMiniGames RCC v1 manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string"
    },
    "icon_path": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "package_format": {
      "type": "string",
      "enum": [
        "rcc-v1"
      ]
    },
    "min_app_version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_file": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_available": {
      "type": "boolean"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "default_locale": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "save_version": {
      "type": "integer",
      "minimum": 1
    },
    "settings_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "plugin_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "orientation": {
      "type": "string",
      "enum": [
        "any",
        "portrait",
        "landscape"
      ]
    },
    "theme_support": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "full"
      ],
      "description": "Optional visual compatibility declaration; never a trust signal."
    },
    "theme_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Optional standardized surface tokens consumed by the game."
    },
    "api_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Optional host API target. Missing means legacy v0.5/v0.6 compatibility mode."
    },
    "min_api_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Minimum host API required by this package."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "v0.7+ hard requirements. The legacy capabilities field remains informational for old packages."
    }
  },
  "additionalProperties": true,
  "$comment": "All fields added after the legacy minimum are optional. Security-sensitive trust is never granted by manifest fields."
}
