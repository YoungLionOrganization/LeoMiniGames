{
  "id": "example_modern",
  "name": "Modern API Example",
  "version": "1.0.0",
  "author": "YoungLion",
  "category": "Example",
  "description": "RCC v1 example using the additive LeoMiniGames v0.6 services.",
  "package_format": "rcc-v1",
  "entry": "Main.qml",
  "icon": "API",
  "icon_path": "assets/icon.png",
  "min_app_version": "0.6.0",
  "license": "MIT",
  "license_file": "LICENSE",
  "source_available": true,
  "default_locale": "en",
  "locales": ["en", "tr", "az"],
  "tags": ["example", "api", "save", "settings"],
  "capabilities": ["save", "settings", "audio", "haptics", "input", "i18n"],
  "save_version": 2,
  "plugin_level": 2,
  "orientation": "any",
  "settings_schema": {
    "difficulty": {"type": "enum", "values": ["easy", "normal", "hard"], "default": "normal", "label": "Difficulty"},
    "showHints": {"type": "bool", "default": true, "label": "Show hints"}
  }
}
