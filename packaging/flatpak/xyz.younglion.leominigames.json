{
  "app-id": "xyz.younglion.leominigames",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "LeoMiniGames",
  "finish-args": [
    "--share=ipc", "--share=network", "--socket=wayland", "--socket=fallback-x11",
    "--socket=pulseaudio", "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.kwalletd5", "--talk-name=org.kde.kwalletd6"
  ],
  "modules": [{
    "name": "leominigames",
    "buildsystem": "cmake-ninja",
    "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=OFF", "-DLEOMINIGAMES_ENABLE_AUDIO=ON"],
    "sources": [{"type": "dir", "path": "../.."}]
  }]
}
